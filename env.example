# Sao chép file này thành `.env` rồi điền giá trị thật.
# `.env` đã bị .gitignore — KHÔNG bao giờ commit key vào git.

# OpenRouter — tạo key tại https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini — tạo key tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Tavily (tra cứu web cho AI Coach, tùy chọn) — https://tavily.com
TAVILY_API_KEY=

# Supabase (tùy chọn nếu chưa có) — https://supabase.com
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Firebase Auth — thêm Web app tại console.firebase.google.com rồi dán config
# (6 trường này được Firebase "công khai" cho phía client nên không phải bí mật).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=