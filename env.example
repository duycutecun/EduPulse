# Sao chép file này thành `.env` rồi điền giá trị thật.
# `.env` đã bị .gitignore — KHÔNG bao giờ commit key vào git.

# OpenRouter — tạo key tại https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini — tạo key tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq — AI chính (free & nhanh nhất), đọc qua proxy /api/groq.
# Tạo key miễn phí tại https://console.groq.com/keys (KHÔNG cần thẻ).
# Giới hạn free: ~30 requests/phút, ~1000 req/ngày, ~8K tokens/phút
# (tính cả `max_tokens` trong request — proxy api/groq.js mặc định ~1200).
# Groq không dùng dữ liệu app để train (no-training mode), xem docs/AI_GROQ.md.
GROQ_API_KEY=

# Tavily (tra cứu web cho AI Coach, tùy chọn) — https://tavily.com
TAVILY_API_KEY=

# Supabase (tùy chọn nếu chưa có) — https://supabase.com
#
# ⚠️ TUYỆT ĐỐI KHÔNG thêm `SUPABASE_SERVICE_ROLE_KEY` vào file này.
# Key đó bỏ qua RLS — ai có nó là toàn quyền với database. `local_env.sh` ném
# MỌI biến trong `.env` thành `--dart-define`, nên key sẽ bị đóng gói vào
# `main.dart.js` và gửi tới trình duyệt của mọi người dùng.
# Key service_role chỉ đặt trong Vercel (Settings → Environment Variables),
# nơi `api/backup.js` đọc được và người dùng không.
SUPABASE_URL=
SUPABASE_ANON_KEY=
